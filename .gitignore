# Game data and everything derived from it: never commit or share these.
*.iso
*.xex
/game/
/ppc/
/ppc_tu6/
/analysis/
/userdata/
/dlc/
/title_update/
/mods/*
!/mods/README.txt

# Downloaded and built by install.py
/tools/
/thirdparty/*
# AMD's Anti-Lag 2 SDK header (MIT), kept as it is: see its SOURCE. Only these
# three files, should more of the SDK be unpacked there.
!/thirdparty/antilag2/
/thirdparty/antilag2/*
!/thirdparty/antilag2/ffx_antilag2_dx12.h
!/thirdparty/antilag2/LICENSE.txt
!/thirdparty/antilag2/SOURCE
/build/
/build-*/
/xenia/third_party

# Local leftovers
__pycache__/
*.orig
*.pyc
/config/*.gen.toml
/dist/
